    "Fidelity Monthly": {
        "prefix": "fdetm",
        "body": ["${1:$CURRENT_YEAR}-${2:$CURRENT_MONTH}-${3:$CURRENT_DATE}   (Direct Debit) Destiny II",
                 "  assets:investments:Fidelity_Warren_Roth_IRA  166.66",
                 "  assets:banking:Wells_Fargo:checking         -166.66",
                 "$0"
                ],
        "description": "Enter a withdrawal for Fidelity Roth IRA monthly investment"
    },
