{
    "Fidelity Monthly": {
        "prefix": "fdetm",
        "body": ["",
                 "${1:year}-${2:month}-${3:day} * (Direct Debit) Destiny II",
                 "  assets:investments:Fidelity_Warren_Roth_IRA:$1$2$3  ${4:shares} FDETX @@ 166.66",
                 "  assets:banking:Wells_Fargo_Checking      -166.66",
                 "$0"
                ],
        "description": "Enter a statement for Fidelity Roth IRA monthly investment"
    },
    "Fidelity add shares": {
        "prefix": ":fdetx",
        "body": [":${1:lot}  ${2:shares} FDETX @@$0"
                ],
        "description": "Edit a Fidelity Roth IRA monthly investment to add shares and lot"
    },
    "Fidelity Reinvestment": {
        "prefix": "fdetr",
        "body": ["",
                 "${1:year}-${2:month}-${3:day} *   Fidelity ${4:type} investment",
                 "  assets:investments:Fidelity_Warren_Roth_IRA:$1$2$3  ${5:shares} FDETX @@ ${6:price}",
                 "  income:investment_gains:Fidelity_Warren_Roth_IRA",
                 "$0"
                ],
        "description": "Enter a statement for Fidelity Roth IRA reinvestment"
    },
    "Fidelity Lot": {
        "prefix": "fdetl",
        "body": ["account assets:investments:Fidelity_Warren_Roth_IRA:${1:date}",
                 "$0"
                ],
        "description": "Enter a new lot account for Fidelity Roth IRA"
    },
    "Fidelity Price": {
        "prefix": "fdetp",
        "body": ["P ${1:year}-${2:month}-${3:day} FDETX ${4:price}",
                 "$0"
                ],
        "description": "Enter a new price for Fidelity Roth IRA"
    },
